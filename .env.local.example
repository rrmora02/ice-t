# Copia este archivo a .env.local y llena los valores.
#   cp .env.local.example .env.local
#
# .env.local está en .gitignore: NUNCA lo subas al repositorio.

# ---------------------------------------------------------------------
# Supabase · Project Settings → API
# ---------------------------------------------------------------------

# Project URL (ej. https://abcdefghijklm.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Llave "anon public". Es segura de exponer en el navegador: toda la
# protección real vive en las políticas RLS de la base de datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave "service_role". IGNORA RLS por completo — es equivalente a la
# contraseña de la base de datos.
#   * Sólo se usa en el servidor (src/lib/supabase/admin.ts).
#   * NUNCA le pongas el prefijo NEXT_PUBLIC_.
#   * Si alguna vez se filtra, rótala desde el panel de Supabase.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Web Push · notificaciones de reabasto (opcional)
# ---------------------------------------------------------------------
# Genera el par de llaves una sola vez con:
#   npx web-push generate-vapid-keys
#
# Aquí va SÓLO la pública. La privada se configura como secret de la Edge
# Function (VAPID_PRIVATE_KEY), nunca en el bundle del navegador.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
